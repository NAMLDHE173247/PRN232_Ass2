@model List<ass01_FE.Presentation.Models.News.NewsArticleDto>
@{
    ViewData["Title"] = "Published News";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Published News</h2>
    
    <form class="d-flex" method="get" asp-action="Index">
        <input class="form-control me-2" type="search" placeholder="Search news..." name="keyword" value="@ViewBag.Keyword">
        <button class="btn btn-outline-primary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Keyword))
        {
            <a href="/" class="btn btn-outline-secondary ms-2">Clear</a>
        }
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No news articles found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-action="Detail" asp-route-id="@item.NewsArticleId" class="text-decoration-none">
                                @item.NewsTitle
                            </a>
                        </h5>
                        <h6 class="card-subtitle mb-2 text-muted">@item.Headline</h6>
                        
                        <div class="mt-3">
                            <span class="badge bg-secondary">@item.CategoryName</span>
                            @if (item.Tags != null && item.Tags.Any())
                            {
                                foreach (var tag in item.Tags)
                                {
                                    <span class="badge bg-light text-dark border">#@tag.TagName</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="card-footer text-muted bg-white d-flex justify-content-between">
                        <small>By @item.CreatedByName</small>
                        <small>@item.CreatedDate?.ToString("MMM dd, yyyy")</small>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-keyword="@ViewBag.Keyword">Previous</a>
                </li>
                
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-keyword="@ViewBag.Keyword">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-keyword="@ViewBag.Keyword">Next</a>
                </li>
            </ul>
        </nav>
    }
}
