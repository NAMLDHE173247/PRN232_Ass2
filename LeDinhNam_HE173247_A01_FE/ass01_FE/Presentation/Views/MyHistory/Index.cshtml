@model List<ass01_FE.Presentation.Models.News.NewsArticleDto>
@{
    ViewData["Title"] = "My News History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My News History</h2>
</div>

<div class="table-responsive shadow-sm bg-white p-3 rounded">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Tags</th>
                <th>Status</th>
                <th>Created Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var news in Model)
                {
                    <tr>
                        <td>@news.NewsArticleId</td>
                        <td>@news.NewsTitle</td>
                        <td>@news.CategoryName</td>
                        <td>
                            @foreach (var t in news.Tags)
                            {
                                <span class="badge bg-secondary me-1">@t.TagName</span>
                            }
                        </td>
                        <td>
                            @if (news.NewsStatus == true) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>@news.CreatedDate?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted">No news articles found in your history.</td></tr>
            }
        </tbody>
    </table>
</div>
