@model List<ass01_FE.Presentation.Models.News.NewsArticleDto>
@{
    ViewData["Title"] = "News Management";
    
    int totalCount = ViewBag.TotalCount ?? 0;
    int skip = ViewBag.Skip ?? 0;
    int top = ViewBag.Top ?? 10;
    
    int currentPage = (skip / top) + 1;
    int totalPages = (int)Math.Ceiling((double)totalCount / top);

    var categories = ViewBag.Categories as ass01_FE.DataAccess.Services.CategoryListResult;
    var tags = ViewBag.Tags as List<ass01_FE.Presentation.Models.News.TagDto>;

    Func<string, string> escapeJs = (str) => {
        if (string.IsNullOrEmpty(str)) return "";
        return str.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", "");
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>News Management</h2>
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal">
        + Create News
    </button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Title, Content..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @if (categories?.Value != null)
                    {
                        foreach (var cat in categories.Value)
                        {
                            <option value="@cat.CategoryId" selected="@(ViewBag.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Tag Name</label>
                <input type="text" name="tagName" value="@ViewBag.TagName" class="form-control" placeholder="Tag..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Author Name</label>
                <input type="text" name="authorName" value="@ViewBag.AuthorName" class="form-control" placeholder="Author..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="newsStatus" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(ViewBag.NewsStatus == true)">Active</option>
                    <option value="false" selected="@(ViewBag.NewsStatus == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Per Page</label>
                <select name="top" class="form-select">
                    <option value="10" selected="@(top == 10)">10</option>
                    <option value="20" selected="@(top == 20)">20</option>
                    <option value="50" selected="@(top == 50)">50</option>
                </select>
            </div>
            <div class="col-12 mt-3">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div id="alertContainer"></div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Tags</th>
                <th>Status</th>
                <th>Created</th>
                <th>Updated By</th>
                <th>Modified</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var news in Model)
                {
                    <tr>
                        <td>@news.NewsArticleId</td>
                        <td>@news.NewsTitle</td>
                        <td>@news.CategoryName</td>
                        <td>
                            @foreach (var t in news.Tags)
                            {
                                <span class="badge bg-secondary me-1">@t.TagName</span>
                            }
                        </td>
                        <td>
                            @if (news.NewsStatus == true) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>@news.CreatedDate?.ToString("yyyy-MM-dd")</td>
                        <td>@news.UpdatedByName</td>
                        <td>@news.ModifiedDate?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @{
                                var tagsJson = System.Text.Json.JsonSerializer.Serialize(news.Tags.Select(t => t.TagId));
                            }
                            <button class="btn btn-sm btn-outline-primary" onclick="openEditModal('@news.NewsArticleId', '@escapeJs(news.NewsTitle)', '@escapeJs(news.Headline)', '@escapeJs(news.NewsContent)', '@escapeJs(news.NewsSource)', @(news.CategoryId?.ToString() ?? "null"), @(news.NewsStatus == true ? "true" : "false"), @tagsJson)">Edit</button>
                            <button class="btn btn-sm btn-outline-info" onclick="duplicateNews('@news.NewsArticleId')">Duplicate</button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteNews('@news.NewsArticleId')">Delete</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="9" class="text-center text-muted">No news articles found.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                int pSkip = (i - 1) * top;
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?keyword=@ViewBag.Keyword&categoryId=@ViewBag.CategoryId&tagName=@ViewBag.TagName&authorName=@ViewBag.AuthorName&newsStatus=@ViewBag.NewsStatus&startDate=@ViewBag.StartDate&endDate=@ViewBag.EndDate&skip=@pSkip&top=@top">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create News</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createForm" class="needs-validation" novalidate>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="c_title" required maxlength="400" />
                            <div class="invalid-feedback">Title is required (max 400).</div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Headline</label>
                            <input type="text" class="form-control" id="c_headline" required maxlength="150" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Content</label>
                            <textarea class="form-control" id="c_content" rows="4" required></textarea>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Source</label>
                            <input type="text" class="form-control" id="c_source" maxlength="400" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="c_category">
                                <option value="">None</option>
                                @if (categories?.Value != null)
                                {
                                    foreach (var cat in categories.Value)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tags (Ctrl+Click for multiple)</label>
                            <select class="form-select" id="c_tags" multiple size="4">
                                @if (tags != null)
                                {
                                    foreach (var t in tags)
                                    {
                                        <option value="@t.TagId">@t.TagName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12 mb-3 form-check ms-3">
                            <input type="checkbox" class="form-check-input" id="c_status" checked />
                            <label class="form-check-label">Is Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnCreate" onclick="createNews()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit News</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm" class="needs-validation" novalidate>
                    <input type="hidden" id="e_id" />
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="e_title" required maxlength="400" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Headline</label>
                            <input type="text" class="form-control" id="e_headline" required maxlength="150" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Content</label>
                            <textarea class="form-control" id="e_content" rows="4" required></textarea>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Source</label>
                            <input type="text" class="form-control" id="e_source" maxlength="400" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="e_category">
                                <option value="">None</option>
                                @if (categories?.Value != null)
                                {
                                    foreach (var cat in categories.Value)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tags (Ctrl+Click for multiple)</label>
                            <select class="form-select" id="e_tags" multiple size="4">
                                @if (tags != null)
                                {
                                    foreach (var t in tags)
                                    {
                                        <option value="@t.TagId">@t.TagName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12 mb-3 form-check ms-3">
                            <input type="checkbox" class="form-check-input" id="e_status" />
                            <label class="form-check-label">Is Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnEdit" onclick="updateNews()">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAlert(msg, type = 'success') {
            const box = document.getElementById('alertContainer');
            box.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show">
                ${msg}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
        }

        async function loadTable() {
            const keyword = document.querySelector('input[name="keyword"]').value || '';
            const categoryId = document.querySelector('select[name="categoryId"]').value || '';
            const tagName = document.querySelector('input[name="tagName"]').value || '';
            const authorName = document.querySelector('input[name="authorName"]').value || '';
            const newsStatus = document.querySelector('select[name="newsStatus"]').value || '';
            const startDate = document.querySelector('input[name="startDate"]').value || '';
            const endDate = document.querySelector('input[name="endDate"]').value || '';
            const top = document.querySelector('select[name="top"]').value || 10;
            const skip = @skip; // keep current skip

            try {
                let url = `/StaffNews/GetList?keyword=${encodeURIComponent(keyword)}&tagName=${encodeURIComponent(tagName)}&authorName=${encodeURIComponent(authorName)}&skip=${skip}&top=${top}`;
                if (categoryId) url += `&categoryId=${categoryId}`;
                if (newsStatus) url += `&newsStatus=${newsStatus}`;
                if (startDate) url += `&startDate=${startDate}`;
                if (endDate) url += `&endDate=${endDate}`;
                
                const res = await fetch(url);
                if (res.ok) {
                    const data = await res.json();
                    const tbody = document.querySelector('table tbody');
                    tbody.innerHTML = '';
                    
                    if (!data.items || data.items.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">No news articles found.</td></tr>';
                        return;
                    }
                    
                    data.items.forEach(news => {
                        let statusBadge = news.newsStatus ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>';
                        let tagsHtml = (news.tags || []).map(t => `<span class="badge bg-secondary me-1">${t.tagName}</span>`).join('');
                        let createdDate = news.createdDate ? new Date(news.createdDate).toISOString().split('T')[0] : '';
                        let modifiedDate = news.modifiedDate ? new Date(news.modifiedDate).toISOString().split('T')[0] : '';
                        
                        const escTitle = news.newsTitle ? news.newsTitle.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        const escHeadline = news.headline ? news.headline.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        const escContent = news.newsContent ? news.newsContent.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        const escSource = news.newsSource ? news.newsSource.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        
                        const tagsJson = JSON.stringify((news.tags || []).map(t => t.tagId));
                        
                        tbody.innerHTML += `<tr>
                            <td>${news.newsArticleId}</td>
                            <td>${news.newsTitle}</td>
                            <td>${news.categoryName || ''}</td>
                            <td>${tagsHtml}</td>
                            <td>${statusBadge}</td>
                            <td>${createdDate}</td>
                            <td>${news.updatedByName || ''}</td>
                            <td>${modifiedDate}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" onclick="openEditModal('${news.newsArticleId}', '${escTitle}', '${escHeadline}', '${escContent}', '${escSource}', ${news.categoryId !== null ? news.categoryId : 'null'}, ${news.newsStatus}, ${tagsJson.replace(/"/g, "&quot;")})">Edit</button>
                                <button class="btn btn-sm btn-outline-info" onclick="duplicateNews('${news.newsArticleId}')">Duplicate</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteNews('${news.newsArticleId}')">Delete</button>
                            </td>
                        </tr>`;
                    });
                }
            } catch(e) {
                console.error("Failed to reload table", e);
            }
        }

        async function createNews() {
            const form = document.getElementById('createForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const btn = document.getElementById('btnCreate');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Saving...';
            btn.disabled = true;

            const categoryVal = document.getElementById('c_category').value;
            const tagSelect = document.getElementById('c_tags');
            const selectedTags = Array.from(tagSelect.selectedOptions).map(opt => parseInt(opt.value));

            const data = {
                newsTitle: document.getElementById('c_title').value,
                headline: document.getElementById('c_headline').value,
                newsContent: document.getElementById('c_content').value,
                newsSource: document.getElementById('c_source').value,
                categoryId: categoryVal ? parseInt(categoryVal) : null,
                newsStatus: document.getElementById('c_status').checked,
                tagIds: selectedTags
            };

            try {
                const response = await fetch('/StaffNews/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const res = await response.json();
                if (response.ok) {
                    showAlert(res.message, 'success');
                    bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
                    form.reset();
                    form.classList.remove('was-validated');
                    await loadTable();
                } else {
                    showAlert(res.message || 'Failed to create', 'danger');
                    bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
                }
            } catch (err) {
                showAlert('Network error', 'danger');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        function openEditModal(id, title, headline, content, source, categoryId, status, tagIds) {
            document.getElementById('e_id').value = id;
            document.getElementById('e_title').value = title;
            document.getElementById('e_headline').value = headline;
            document.getElementById('e_content').value = content;
            document.getElementById('e_source').value = source || '';
            document.getElementById('e_category').value = categoryId || '';
            document.getElementById('e_status').checked = status;

            const tagSelect = document.getElementById('e_tags');
            Array.from(tagSelect.options).forEach(opt => {
                opt.selected = tagIds.includes(parseInt(opt.value));
            });
            
            document.getElementById('editForm').classList.remove('was-validated');
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        async function updateNews() {
            const form = document.getElementById('editForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const btn = document.getElementById('btnEdit');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Updating...';
            btn.disabled = true;

            const id = document.getElementById('e_id').value;
            const categoryVal = document.getElementById('e_category').value;
            const tagSelect = document.getElementById('e_tags');
            const selectedTags = Array.from(tagSelect.selectedOptions).map(opt => parseInt(opt.value));

            const data = {
                newsTitle: document.getElementById('e_title').value,
                headline: document.getElementById('e_headline').value,
                newsContent: document.getElementById('e_content').value,
                newsSource: document.getElementById('e_source').value,
                categoryId: categoryVal ? parseInt(categoryVal) : null,
                newsStatus: document.getElementById('e_status').checked,
                tagIds: selectedTags
            };

            try {
                const response = await fetch(`/StaffNews/Update/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const res = await response.json();
                if (response.ok) {
                    showAlert(res.message, 'success');
                    bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                    await loadTable();
                } else {
                    showAlert(res.message || 'Failed to update', 'danger');
                    bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                }
            } catch (err) {
                showAlert('Network error', 'danger');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        async function duplicateNews(id) {
            if (!confirm('Are you sure you want to duplicate this news?')) return;

            try {
                const response = await fetch(`/StaffNews/Duplicate/${id}`, { method: 'POST' });
                const res = await response.json();
                if (response.ok) {
                    showAlert(res.message, 'success');
                    await loadTable();
                } else {
                    showAlert(res.message || 'Failed to duplicate', 'danger');
                }
            } catch (err) {
                showAlert('Network error', 'danger');
            }
        }

        async function deleteNews(id) {
            if (!confirm('Are you sure you want to delete this news?')) return;

            try {
                const response = await fetch(`/StaffNews/Delete/${id}`, { method: 'DELETE' });
                const res = await response.json();
                if (response.ok) {
                    showAlert(res.message, 'success');
                    await loadTable();
                } else {
                    showAlert(res.message || 'Failed to delete', 'danger');
                }
            } catch (err) {
                showAlert('Network error', 'danger');
            }
        }
    </script>
}
