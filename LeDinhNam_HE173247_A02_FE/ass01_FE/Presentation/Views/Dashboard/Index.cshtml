@model ass01_FE.Presentation.Models.Dashboard.DashboardViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Admin Dashboard</h2>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label asp-for="CurrentFilter.StartDate" class="form-label">Start Date</label>
                    <input asp-for="CurrentFilter.StartDate" type="datetime-local" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="CurrentFilter.EndDate" class="form-label">End Date</label>
                    <input asp-for="CurrentFilter.EndDate" type="datetime-local" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="CurrentFilter.CategoryId" class="form-label">Category</label>
                    <select asp-for="CurrentFilter.CategoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="CurrentFilter.Status" class="form-label">Status</label>
                    <select asp-for="CurrentFilter.Status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="CurrentFilter.AuthorId" class="form-label">Author ID</label>
                    <input asp-for="CurrentFilter.AuthorId" type="number" class="form-control" placeholder="Optional" />
                </div>
                <div class="col-md-2 text-end">
                    <button type="submit" class="btn btn-primary w-100 mb-1" id="btnApplyFilter" onclick="setLoadingState('btnApplyFilter')">
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        Apply Filter
                    </button>
                    <button type="submit" asp-action="ExportAnalyticsReportAsync" class="btn btn-success w-100" id="btnExportExcel" onclick="setLoadingState('btnExportExcel')">
                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        Export Excel
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white text-center shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Total Articles</h5>
                <h2 class="display-4">@Model.Statistics.TotalArticles</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white text-center shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Active Articles</h5>
                <h2 class="display-4">@Model.Statistics.ActiveArticles</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-secondary text-white text-center shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Inactive Articles</h5>
                <h2 class="display-4">@Model.Statistics.InactiveArticles</h2>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title text-center">Articles by Category</h5>
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title text-center">Articles by Status</h5>
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title">Trending Articles</h5>
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Views</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TrendingArticles.Any())
                {
                    foreach (var article in Model.TrendingArticles)
                    {
                        <tr>
                            <td>@article.NewsTitle</td>
                            <td>@article.CategoryName</td>
                            <td>@article.AuthorName</td>
                            <td><span class="badge bg-info text-dark">@article.ViewCount</span></td>
                            <td>@article.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No trending articles found for the selected filter.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.min.js"></script>
    <script>
        function setLoadingState(buttonId) {
            var btn = document.getElementById(buttonId);
            btn.classList.add('disabled');
            var spinner = btn.querySelector('.spinner-border');
            if(spinner) {
                spinner.classList.remove('d-none');
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Setup JSON data from Model
            var categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Statistics.ArticlesByCategory));
            var statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Statistics.ArticlesByStatus));

            renderCategoryArticleChart(categoryData);
            renderArticleStatusChart(statusData);
        });

        function renderCategoryArticleChart(categoryData) {
            var ctx = document.getElementById('categoryChart').getContext('2d');
            var labels = categoryData.map(c => c.CategoryName);
            var values = categoryData.map(c => c.Count);
            
            // Default empty state handling
            if (labels.length === 0) {
                labels = ["No Data"];
                values = [1];
            }

            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: [
                            '#0d6efd', '#198754', '#ffc107', '#dc3545', '#0dcaf0', '#6c757d', '#6610f2', '#d63384'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        function renderArticleStatusChart(statusData) {
            var ctx = document.getElementById('statusChart').getContext('2d');
            var labels = statusData.map(s => s.Status);
            var values = statusData.map(s => s.Count);

            if (labels.length === 0) {
                labels = ["No Data"];
                values = [0];
            }

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Article Count',
                        data: values,
                        backgroundColor: '#198754'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });
        }
    </script>
}
