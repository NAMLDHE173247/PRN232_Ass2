@model ass01_FE.DataAccess.Services.CategoryListResult
@{
    ViewData["Title"] = "Category Management";
    
    var items = Model?.Value;
    int totalCount = Model?.Count ?? 0;
    
    int skip = ViewBag.Skip ?? 0;
    int top = ViewBag.Top ?? 10;
    
    int currentPage = (skip / top) + 1;
    int totalPages = (int)Math.Ceiling((double)totalCount / top);

    Func<string, string> escapeJs = (str) => {
        if (string.IsNullOrEmpty(str)) return "";
        return str.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", "");
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Category Management</h2>
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal" @(ViewBag.IsOffline == true ? "disabled title=\"Create is disabled in offline mode\"" : "")>
        + Create Category
    </button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-auto">
                <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" class="form-control" placeholder="Search categories..." />
            </div>
            <div class="col-auto">
                <select name="top" class="form-select">
                    <option value="10" selected="@(top == 10)">10 per page</option>
                    <option value="20" selected="@(top == 20)">20 per page</option>
                    <option value="50" selected="@(top == 50)">50 per page</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div id="alertContainer"></div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Parent ID</th>
                <th>Status</th>
                <th>Articles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (items != null)
            {
                foreach (var cat in items)
                {
                    <tr>
                        <td>@cat.CategoryId</td>
                        <td>@cat.CategoryName</td>
                        <td>@cat.CategoryDescription</td>
                        <td>@(cat.ParentCategoryId?.ToString() ?? "None")</td>
                        <td>
                            @if (cat.IsActive == true) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>@cat.ArticleCount</td>
                        <td>
                            <button class="btn btn-sm btn-outline-info" onclick="viewArticles(@cat.CategoryId, '@escapeJs(cat.CategoryName)')">Articles</button>
                            <button class="btn btn-sm btn-outline-primary" onclick="openEditModal(@cat.CategoryId, '@escapeJs(cat.CategoryName)', '@escapeJs(cat.CategoryDescription)', @(cat.ParentCategoryId?.ToString() ?? "null"), @(cat.IsActive == true ? "true" : "false"))" @(ViewBag.IsOffline == true ? "disabled" : "")>Edit</button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(@cat.CategoryId)" @(ViewBag.IsOffline == true ? "disabled" : "")>Delete</button>
                        </td>
                    </tr>
                }
            }
            @if (items == null || !items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">No categories found.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                int pSkip = (i - 1) * top;
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?searchKeyword=@ViewBag.SearchKeyword&skip=@pSkip&top=@top">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createForm" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="c_name" required maxlength="100" />
                        <div class="invalid-feedback">Name is required (max 100 chars).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="c_desc" required maxlength="250"></textarea>
                        <div class="invalid-feedback">Description is required.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Category ID (Optional)</label>
                        <input type="number" class="form-control" id="c_parent" />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="c_active" checked />
                        <label class="form-check-label">Is Active</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnCreate" onclick="createCategory()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm" class="needs-validation" novalidate>
                    <input type="hidden" id="e_id" />
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="e_name" required maxlength="100" />
                        <div class="invalid-feedback">Name is required (max 100 chars).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="e_desc" required maxlength="250"></textarea>
                        <div class="invalid-feedback">Description is required.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Category ID (Optional)</label>
                        <input type="number" class="form-control" id="e_parent" />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="e_active" />
                        <label class="form-check-label">Is Active</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnEdit" onclick="updateCategory()">Update</button>
            </div>
        </div>
    </div>
</div>

<!-- Articles Modal -->
<div class="modal fade" id="articlesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="articlesModalTitle">Articles for Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="articlesLoading" class="text-center d-none">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm d-none" id="articlesTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Created By</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div id="articlesEmpty" class="text-center text-muted d-none">
                    No articles use this category.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAlert(msg, type = 'success') {
            showAppToast("Notification", msg, type);
        }

        async function loadTable() {
            const keyword = document.querySelector('input[name="searchKeyword"]').value || '';
            const top = document.querySelector('select[name="top"]').value || 10;
            const skip = @skip; // keep current skip

            try {
                const res = await fetch(`/Category/GetList?searchKeyword=${encodeURIComponent(keyword)}&skip=${skip}&top=${top}`);
                if (res.ok) {
                    const data = await res.json();
                    const tbody = document.querySelector('table tbody');
                    tbody.innerHTML = '';
                    
                    if (!data.value || data.value.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No categories found.</td></tr>';
                        return;
                    }
                    
                    data.value.forEach(cat => {
                        let statusBadge = cat.isActive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>';
                        let parentIdText = cat.parentCategoryId !== null ? cat.parentCategoryId : 'None';
                        
                        const escName = cat.categoryName ? cat.categoryName.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        const escDesc = cat.categoryDescription ? cat.categoryDescription.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        
                        tbody.innerHTML += `<tr>
                            <td>${cat.categoryId}</td>
                            <td>${cat.categoryName}</td>
                            <td>${cat.categoryDescription}</td>
                            <td>${parentIdText}</td>
                            <td>${statusBadge}</td>
                            <td>${cat.articleCount}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-info" onclick="viewArticles(${cat.categoryId}, '${escName}')">Articles</button>
                                <button class="btn btn-sm btn-outline-primary" onclick="openEditModal(${cat.categoryId}, '${escName}', '${escDesc}', ${cat.parentCategoryId !== null ? cat.parentCategoryId : 'null'}, ${cat.isActive})">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(${cat.categoryId})">Delete</button>
                            </td>
                        </tr>`;
                    });
                }
            } catch(e) {
                console.error("Failed to reload table", e);
            }
        }

        async function createCategory() {
            const form = document.getElementById('createForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            confirmAction('Are you sure you want to create this category?', async () => {
                const btn = document.getElementById('btnCreate');
                const originalText = btn.innerHTML;
                btn.innerHTML = 'Saving...';
                btn.disabled = true;

                const parentVal = document.getElementById('c_parent').value;
                const data = {
                    categoryName: document.getElementById('c_name').value,
                    categoryDescription: document.getElementById('c_desc').value,
                    parentCategoryId: parentVal ? parseInt(parentVal) : null,
                    isActive: document.getElementById('c_active').checked
                };

                try {
                    showLoading();
                    const response = await fetch('/Category/Create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const res = await response.json();
                    if (response.ok) {
                        showAlert(res.message, 'success');
                        bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
                        form.reset();
                        form.classList.remove('was-validated');
                        await loadTable();
                    } else {
                        showAlert(res.message || 'Failed to create', 'danger');
                        bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
                    }
                } catch (err) {
                    showAlert('Network error', 'danger');
                } finally {
                    hideLoading();
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        }

        function openEditModal(id, name, desc, parentId, isActive) {
            document.getElementById('e_id').value = id;
            document.getElementById('e_name').value = name;
            document.getElementById('e_desc').value = desc;
            document.getElementById('e_parent').value = parentId || '';
            document.getElementById('e_active').checked = isActive;
            
            document.getElementById('editForm').classList.remove('was-validated');
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        async function updateCategory() {
            const form = document.getElementById('editForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            confirmAction('Are you sure you want to update this category?', async () => {
                const btn = document.getElementById('btnEdit');
                const originalText = btn.innerHTML;
                btn.innerHTML = 'Updating...';
                btn.disabled = true;

                const id = document.getElementById('e_id').value;
                const parentVal = document.getElementById('e_parent').value;
                const data = {
                    categoryName: document.getElementById('e_name').value,
                    categoryDescription: document.getElementById('e_desc').value,
                    parentCategoryId: parentVal ? parseInt(parentVal) : null,
                    isActive: document.getElementById('e_active').checked
                };

                try {
                    showLoading();
                    const response = await fetch(`/Category/Update/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const res = await response.json();
                    if (response.ok) {
                        showAlert(res.message, 'success');
                        bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                        await loadTable();
                    } else {
                        showAlert(res.message || 'Failed to update', 'danger');
                        bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                    }
                } catch (err) {
                    showAlert('Network error', 'danger');
                } finally {
                    hideLoading();
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        }

        function deleteCategory(id) {
            confirmAction('Are you sure you want to delete this category?', async function() {
                try {
                    showLoading();
                    const response = await fetch(`/Category/Delete/${id}`, { method: 'DELETE' });
                    const res = await response.json();
                    if (response.ok) {
                        showAlert(res.message, 'success');
                        await loadTable();
                    } else {
                        showAlert(res.message || 'Failed to delete', 'danger');
                    }
                } catch (err) {
                    showAlert('Network error', 'danger');
                } finally {
                    hideLoading();
                }
            });
        }
        async function viewArticles(id, name) {
            document.getElementById('articlesModalTitle').innerText = 'Articles for Category: ' + name;
            
            const loading = document.getElementById('articlesLoading');
            const table = document.getElementById('articlesTable');
            const tbody = table.querySelector('tbody');
            const empty = document.getElementById('articlesEmpty');
            
            loading.classList.remove('d-none');
            table.classList.add('d-none');
            empty.classList.add('d-none');
            tbody.innerHTML = '';
            
            new bootstrap.Modal(document.getElementById('articlesModal')).show();
            
            try {
                const res = await fetch(`/Category/GetNewsForCategory/${id}`);
                if (res.ok) {
                    const data = await res.json();
                    if (data && data.length > 0) {
                        data.forEach(n => {
                            let statusBadge = n.newsStatus ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>';
                            tbody.innerHTML += `<tr>
                                <td>${n.newsArticleId}</td>
                                <td>${n.newsTitle}</td>
                                <td>${n.createdByName || ''}</td>
                                <td>${statusBadge}</td>
                            </tr>`;
                        });
                        table.classList.remove('d-none');
                    } else {
                        empty.classList.remove('d-none');
                    }
                } else {
                    empty.innerText = "Error loading articles.";
                    empty.classList.remove('d-none');
                }
            } catch (e) {
                empty.innerText = "Network error loading articles.";
                empty.classList.remove('d-none');
            } finally {
                loading.classList.add('d-none');
            }
        }
    </script>
}
