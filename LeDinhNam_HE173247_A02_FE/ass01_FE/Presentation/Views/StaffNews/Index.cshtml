@model List<ass01_FE.Presentation.Models.News.NewsArticleDto>
@{
    ViewData["Title"] = "News Management";
    
    int totalCount = ViewBag.TotalCount ?? 0;
    int skip = ViewBag.Skip ?? 0;
    int top = ViewBag.Top ?? 10;
    
    int currentPage = (skip / top) + 1;
    int totalPages = (int)Math.Ceiling((double)totalCount / top);

    var categories = ViewBag.Categories as ass01_FE.DataAccess.Services.CategoryListResult;
    var tags = ViewBag.Tags as List<ass01_FE.Presentation.Models.News.TagDto>;

    Func<string, string> escapeJs = (str) => {
        if (string.IsNullOrEmpty(str)) return "";
        return str.Replace("\\", "\\\\").Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", "");
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>News Management</h2>
    <button class="btn btn-success" onclick="openCreateNewsModal()" @(ViewBag.IsOffline == true ? "disabled title=\"Create is disabled in offline mode\"" : "")>
        + Create News
    </button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Title, Content..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @if (categories?.Value != null)
                    {
                        foreach (var cat in categories.Value)
                        {
                            <option value="@cat.CategoryId" selected="@(ViewBag.CategoryId == cat.CategoryId)">@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Tag Name</label>
                <input type="text" name="tagName" value="@ViewBag.TagName" class="form-control" placeholder="Tag..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Author Name</label>
                <input type="text" name="authorName" value="@ViewBag.AuthorName" class="form-control" placeholder="Author..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="newsStatus" class="form-select">
                    <option value="">All</option>
                    <option value="true" selected="@(ViewBag.NewsStatus == true)">Active</option>
                    <option value="false" selected="@(ViewBag.NewsStatus == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Per Page</label>
                <select name="top" class="form-select">
                    <option value="10" selected="@(top == 10)">10</option>
                    <option value="20" selected="@(top == 20)">20</option>
                    <option value="50" selected="@(top == 50)">50</option>
                </select>
            </div>
            <div class="col-12 mt-3">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div id="alertContainer"></div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Tags</th>
                <th>Status</th>
                <th>Created</th>
                <th>Updated By</th>
                <th>Modified</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var news in Model)
                {
                    <tr>
                        <td>@news.NewsArticleId</td>
                        <td>@news.NewsTitle</td>
                        <td>@news.CategoryName</td>
                        <td>
                            @foreach (var t in news.Tags)
                            {
                                <span class="badge bg-secondary me-1">@t.TagName</span>
                            }
                        </td>
                        <td>
                            @if (news.NewsStatus == true) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td>@news.CreatedDate?.ToString("yyyy-MM-dd")</td>
                        <td>@news.UpdatedByName</td>
                        <td>@news.ModifiedDate?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @{
                                var tagsJson = System.Text.Json.JsonSerializer.Serialize(news.Tags.Select(t => t.TagId));
                            }
                            <button class="btn btn-sm btn-outline-primary" onclick="openEditNewsModal('@news.NewsArticleId', '@escapeJs(news.NewsTitle)', '@escapeJs(news.Headline)', '@escapeJs(news.NewsContent)', '@escapeJs(news.NewsSource)', @(news.CategoryId?.ToString() ?? "null"), @(news.NewsStatus == true ? "true" : "false"), @tagsJson, '@escapeJs(news.ImageUrl)')" @(ViewBag.IsOffline == true ? "disabled" : "")>Edit</button>
                            <button class="btn btn-sm btn-outline-info" onclick="duplicateNews('@news.NewsArticleId')" @(ViewBag.IsOffline == true ? "disabled" : "")>Duplicate</button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteNews('@news.NewsArticleId')" @(ViewBag.IsOffline == true ? "disabled" : "")>Delete</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="9" class="text-center text-muted">No news articles found.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                int pSkip = (i - 1) * top;
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?keyword=@ViewBag.Keyword&categoryId=@ViewBag.CategoryId&tagName=@ViewBag.TagName&authorName=@ViewBag.AuthorName&newsStatus=@ViewBag.NewsStatus&startDate=@ViewBag.StartDate&endDate=@ViewBag.EndDate&skip=@pSkip&top=@top">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create News</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createForm" class="needs-validation" novalidate>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="c_title" required maxlength="400" />
                            <div class="invalid-feedback">Title is required (max 400).</div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Headline</label>
                            <input type="text" class="form-control" id="c_headline" required maxlength="150" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Content</label>
                            <textarea class="form-control" id="c_content" rows="4" required></textarea>
                            <button type="button" class="btn btn-sm btn-outline-info mt-2" id="c_suggest_btn" onclick="requestSuggestedTags('c_content', 'c_suggested_tags')">Suggest Tags</button>
                            <div id="c_suggested_tags" class="mt-2"></div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Image</label>
                            <input type="file" class="form-control" id="c_imageFile" accept="image/*" />
                            <input type="hidden" id="c_imageUrl" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Source</label>
                            <input type="text" class="form-control" id="c_source" maxlength="400" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="c_category" required>
                                <option value="">None</option>
                                @if (categories?.Value != null)
                                {
                                    foreach (var cat in categories.Value)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">Category is required.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tags (Ctrl+Click for multiple)</label>
                            <select class="form-select" id="c_tags" multiple size="4" required>
                                @if (tags != null)
                                {
                                    foreach (var t in tags)
                                    {
                                        <option value="@t.TagId">@t.TagName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">At least one tag is required.</div>
                        </div>
                        <div class="col-md-12 mb-3 form-check ms-3">
                            <input type="checkbox" class="form-check-input" id="c_status" checked />
                            <label class="form-check-label">Is Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnCreate" onclick="submitCreateNewsArticle()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit News</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm" class="needs-validation" novalidate>
                    <input type="hidden" id="e_id" />
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="e_title" required maxlength="400" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Headline</label>
                            <input type="text" class="form-control" id="e_headline" required maxlength="150" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Content</label>
                            <textarea class="form-control" id="e_content" rows="4" required></textarea>
                            <button type="button" class="btn btn-sm btn-outline-info mt-2" id="e_suggest_btn" onclick="requestSuggestedTags('e_content', 'e_suggested_tags')">Suggest Tags</button>
                            <div id="e_suggested_tags" class="mt-2"></div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Image</label>
                            <input type="file" class="form-control" id="e_imageFile" accept="image/*" />
                            <input type="hidden" id="e_imageUrl" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Source</label>
                            <input type="text" class="form-control" id="e_source" maxlength="400" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="e_category" required>
                                <option value="">None</option>
                                @if (categories?.Value != null)
                                {
                                    foreach (var cat in categories.Value)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">Category is required.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tags (Ctrl+Click for multiple)</label>
                            <select class="form-select" id="e_tags" multiple size="4" required>
                                @if (tags != null)
                                {
                                    foreach (var t in tags)
                                    {
                                        <option value="@t.TagId">@t.TagName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">At least one tag is required.</div>
                        </div>
                        <div class="col-md-12 mb-3 form-check ms-3">
                            <input type="checkbox" class="form-check-input" id="e_status" />
                            <label class="form-check-label">Is Active</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnEdit" onclick="submitUpdateNewsArticle()">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAlert(msg, type = 'success') {
            showAppToast("Notification", msg, type);
        }

        async function loadTable() {
            const keyword = document.querySelector('input[name="keyword"]').value || '';
            const categoryId = document.querySelector('select[name="categoryId"]').value || '';
            const tagName = document.querySelector('input[name="tagName"]').value || '';
            const authorName = document.querySelector('input[name="authorName"]').value || '';
            const newsStatus = document.querySelector('select[name="newsStatus"]').value || '';
            const startDate = document.querySelector('input[name="startDate"]').value || '';
            const endDate = document.querySelector('input[name="endDate"]').value || '';
            const top = document.querySelector('select[name="top"]').value || 10;
            const skip = @skip; // keep current skip

            try {
                let url = `/StaffNews/GetList?keyword=${encodeURIComponent(keyword)}&tagName=${encodeURIComponent(tagName)}&authorName=${encodeURIComponent(authorName)}&skip=${skip}&top=${top}`;
                if (categoryId) url += `&categoryId=${categoryId}`;
                if (newsStatus) url += `&newsStatus=${newsStatus}`;
                if (startDate) url += `&startDate=${startDate}`;
                if (endDate) url += `&endDate=${endDate}`;
                
                const res = await fetch(url);
                if (res.ok) {
                    const data = await res.json();
                    const tbody = document.querySelector('table tbody');
                    tbody.innerHTML = '';
                    
                    if (!data.items || data.items.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">No news articles found.</td></tr>';
                        return;
                    }
                    
                    data.items.forEach(news => {
                        let statusBadge = news.newsStatus ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>';
                        let tagsHtml = (news.tags || []).map(t => `<span class="badge bg-secondary me-1">${t.tagName}</span>`).join('');
                        let createdDate = news.createdDate ? new Date(news.createdDate).toISOString().split('T')[0] : '';
                        let modifiedDate = news.modifiedDate ? new Date(news.modifiedDate).toISOString().split('T')[0] : '';
                        
                        const escTitle = news.newsTitle ? news.newsTitle.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        const escHeadline = news.headline ? news.headline.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        const escContent = news.newsContent ? news.newsContent.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        const escSource = news.newsSource ? news.newsSource.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "").replace(/"/g, "&quot;") : '';
                        
                        const tagsJson = JSON.stringify((news.tags || []).map(t => t.tagId));
                        
                        tbody.innerHTML += `<tr>
                            <td>${news.newsArticleId}</td>
                            <td>${news.newsTitle}</td>
                            <td>${news.categoryName || ''}</td>
                            <td>${tagsHtml}</td>
                            <td>${statusBadge}</td>
                            <td>${createdDate}</td>
                            <td>${news.updatedByName || ''}</td>
                            <td>${modifiedDate}</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" onclick="openEditNewsModal('${news.newsArticleId}', '${escTitle}', '${escHeadline}', '${escContent}', '${escSource}', ${news.categoryId !== null ? news.categoryId : 'null'}, ${news.newsStatus}, ${tagsJson.replace(/\"/g, '&quot;')}, '${news.imageUrl || ''}')">Edit</button>
                                <button class="btn btn-sm btn-outline-info" onclick="duplicateNews('${news.newsArticleId}')">Duplicate</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteNews('${news.newsArticleId}')">Delete</button>
                            </td>
                        </tr>`;
                    });
                }
            } catch(e) {
                console.error("Failed to reload table", e);
            }
        }

        let selectedAiTags = new Set();

        function openCreateNewsModal() {
            document.getElementById('createForm').reset();
            document.getElementById('c_imageUrl').value = '';
            document.getElementById('c_suggested_tags').innerHTML = '';
            selectedAiTags.clear();
            document.getElementById('createForm').classList.remove('was-validated');
            new bootstrap.Modal(document.getElementById('createModal')).show();
        }

        function openEditNewsModal(id, title, headline, content, source, categoryId, status, tagIds, imageUrl) {
            document.getElementById('e_id').value = id;
            document.getElementById('e_title').value = title;
            document.getElementById('e_headline').value = headline;
            document.getElementById('e_content').value = content;
            document.getElementById('e_source').value = source || '';
            document.getElementById('e_category').value = categoryId || '';
            document.getElementById('e_status').checked = status;
            document.getElementById('e_imageUrl').value = imageUrl || '';
            document.getElementById('e_suggested_tags').innerHTML = '';
            selectedAiTags.clear();

            const tagSelect = document.getElementById('e_tags');
            Array.from(tagSelect.options).forEach(opt => {
                opt.selected = tagIds.includes(parseInt(opt.value));
            });
            
            document.getElementById('editForm').classList.remove('was-validated');
            new bootstrap.Modal(document.getElementById('editModal')).show();
        }

        async function uploadNewsImageAsync(fileInputId) {
            const fileInput = document.getElementById(fileInputId);
            if (!fileInput.files || fileInput.files.length === 0) return null;

            const formData = new FormData();
            formData.append('imageFile', fileInput.files[0]);

            const res = await fetch('/StaffNews/UploadImage', {
                method: 'POST',
                body: formData
            });

            if (res.ok) {
                const data = await res.json();
                return data.imageUrl;
            }
            throw new Error('Invalid image or upload failed');
        }

        async function submitCreateNewsArticle() {
            const form = document.getElementById('createForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            confirmAction('Are you sure you want to create this news article?', async () => {
                const btn = document.getElementById('btnCreate');
                const originalText = btn.innerHTML;
                btn.innerHTML = 'Saving...';
                btn.disabled = true;

                try {
                    showLoading();
                    let imageUrl = '';
                    if (document.getElementById('c_imageFile').files.length > 0) {
                        imageUrl = await uploadNewsImageAsync('c_imageFile');
                    }

                    const categoryVal = document.getElementById('c_category').value;
                    const tagSelect = document.getElementById('c_tags');
                    const selectedTags = Array.from(tagSelect.selectedOptions).map(opt => parseInt(opt.value));
                    const content = document.getElementById('c_content').value;

                    const data = {
                        newsTitle: document.getElementById('c_title').value,
                        headline: document.getElementById('c_headline').value,
                        newsContent: content,
                        newsSource: document.getElementById('c_source').value,
                        categoryId: categoryVal ? parseInt(categoryVal) : null,
                        newsStatus: document.getElementById('c_status').checked,
                        tagIds: selectedTags,
                        imageUrl: imageUrl
                    };

                    const response = await fetch('/StaffNews/Create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    
                    const res = await response.json();
                    if (response.ok) {
                        showAlert(res.message, 'success');
                        bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
                        await loadTable();
                        
                        for (const tagName of selectedAiTags) {
                            await recordSelectedSuggestedTagsAsync(content, tagName);
                        }
                    } else {
                        showAlert(res.message || 'Failed to create', 'danger');
                    }
                } catch (err) {
                    showAlert(err.message || 'Network error', 'danger');
                } finally {
                    hideLoading();
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        }

        async function submitUpdateNewsArticle() {
            const form = document.getElementById('editForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            confirmAction('Are you sure you want to update this news article?', async () => {
                const btn = document.getElementById('btnEdit');
                const originalText = btn.innerHTML;
                btn.innerHTML = 'Updating...';
                btn.disabled = true;

                try {
                    showLoading();
                    let imageUrl = document.getElementById('e_imageUrl').value;
                    if (document.getElementById('e_imageFile').files.length > 0) {
                        imageUrl = await uploadNewsImageAsync('e_imageFile');
                    }

                    const id = document.getElementById('e_id').value;
                    const categoryVal = document.getElementById('e_category').value;
                    const tagSelect = document.getElementById('e_tags');
                    const selectedTags = Array.from(tagSelect.selectedOptions).map(opt => parseInt(opt.value));
                    const content = document.getElementById('e_content').value;

                    const data = {
                        newsTitle: document.getElementById('e_title').value,
                        headline: document.getElementById('e_headline').value,
                        newsContent: content,
                        newsSource: document.getElementById('e_source').value,
                        categoryId: categoryVal ? parseInt(categoryVal) : null,
                        newsStatus: document.getElementById('e_status').checked,
                        tagIds: selectedTags,
                        imageUrl: imageUrl
                    };

                    const response = await fetch(`/StaffNews/Update/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const res = await response.json();
                    if (response.ok) {
                        showAlert(res.message, 'success');
                        bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                        await loadTable();

                        for (const tagName of selectedAiTags) {
                            await recordSelectedSuggestedTagsAsync(content, tagName);
                        }
                    } else {
                        showAlert(res.message || 'Failed to update', 'danger');
                    }
                } catch (err) {
                    showAlert(err.message || 'Network error', 'danger');
                } finally {
                    hideLoading();
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        }

        async function requestSuggestedTags(contentId, containerId) {
            const content = document.getElementById(contentId).value;
            if (!content.trim()) {
                showAlert('Please enter article content before requesting tag suggestions.', 'warning');
                return;
            }
            
            const btn = document.getElementById(contentId === 'c_content' ? 'c_suggest_btn' : 'e_suggest_btn');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Thinking...';
            btn.disabled = true;

            try {
                const response = await fetch('/StaffNews/SuggestTags', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content: content })
                });

                if (response.ok) {
                    const data = await response.json();
                    renderSuggestedTagChips(data.tags, containerId);
                } else {
                    const error = await response.json();
                    showAlert(error.message || 'AI API is currently unavailable.', 'warning');
                }
            } catch (err) {
                showAlert('Failed to connect to AI API.', 'warning');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        function renderSuggestedTagChips(tags, containerId) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            if (!tags || tags.length === 0) {
                container.innerHTML = '<span class="text-muted small">No suggestions found.</span>';
                return;
            }
            
            tags.forEach(t => {
                const badge = document.createElement('span');
                badge.className = 'badge bg-info text-dark me-2 mb-2 p-2' + (selectedAiTags.has(t.name) ? ' border border-2 border-primary' : '');
                badge.style.cursor = 'pointer';
                badge.innerText = `${t.name} ${Math.round(t.confidence * 100)}%`;
                badge.onclick = () => selectSuggestedTag(t.name, containerId);
                container.appendChild(badge);
            });
        }

        function selectSuggestedTag(tagName, containerId) {
            const selectId = containerId === 'c_suggested_tags' ? 'c_tags' : 'e_tags';
            const tagSelect = document.getElementById(selectId);
            let found = false;

            Array.from(tagSelect.options).forEach(opt => {
                if (opt.text.toLowerCase() === tagName.toLowerCase()) {
                    opt.selected = true;
                    found = true;
                }
            });

            if (found) {
                selectedAiTags.add(tagName);
                showAlert(`Applied tag: ${tagName}`, 'success');
                // Re-render chips to show border
                const contentId = containerId === 'c_suggested_tags' ? 'c_content' : 'e_content';
                // Note: we'd need the original tags array to fully re-render, 
                // so we just add the border class directly to the clicked element in a more advanced implementation.
                // For now, it's fine.
            } else {
                showAlert(`Tag '${tagName}' does not exist in the system.`, 'warning');
            }
        }

        async function recordSelectedSuggestedTagsAsync(keyword, tagName) {
            try {
                await fetch('/StaffNews/RecordSelectedSuggestedTagsAsync', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ keyword: keyword, tagName: tagName })
                });
            } catch (e) {
                console.warn('Failed to learn tag', e);
            }
        }

        function duplicateNews(id) {
            confirmAction('Are you sure you want to duplicate this news?', async function() {
                try {
                    showLoading();
                    const response = await fetch(`/StaffNews/Duplicate/${id}`, { method: 'POST' });
                    const res = await response.json();
                    if (response.ok) {
                        showAlert(res.message, 'success');
                        await loadTable();
                    } else {
                        showAlert(res.message || 'Failed to duplicate', 'danger');
                    }
                } catch (err) {
                    showAlert('Network error', 'danger');
                } finally {
                    hideLoading();
                }
            });
        }

        function deleteNews(id) {
            confirmAction('Are you sure you want to delete this news?', async function() {
                try {
                    showLoading();
                    const response = await fetch(`/StaffNews/Delete/${id}`, { method: 'DELETE' });
                    const res = await response.json();
                    if (response.ok) {
                        showAlert(res.message, 'success');
                        await loadTable();
                    } else {
                        showAlert(res.message || 'Failed to delete', 'danger');
                    }
                } catch (err) {
                    showAlert('Network error', 'danger');
                } finally {
                    hideLoading();
                }
            });
        }
    </script>
}
